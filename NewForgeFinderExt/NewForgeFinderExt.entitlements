<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Read-only access to the user's Application Support so the extension
	     can share settings.json and Templates with the unsandboxed app. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/NewForge/</string>
	</array>
	<!-- Lets us ask Finder (which is unsandboxed) to place the staged file
	     anywhere the user can see. One-time TCC automation consent, then it
	     works in every folder - no per-directory grants needed. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
